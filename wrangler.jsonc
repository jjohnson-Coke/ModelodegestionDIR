// Configuración de Cloudflare Workers (sitio estático).
// El build (`npm run build`) genera `dist/`; `npx wrangler deploy` publica esa carpeta tal cual.
{
  "name": "modelodegestiondir",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
